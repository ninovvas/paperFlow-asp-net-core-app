@model PaperFlow.Web.ViewModels.Account.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}
<link rel="stylesheet" href="~/css/paperflow-profile.css" asp-append-version="true" />

<div class="pf-profile-page">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Papers" asp-action="Index">My Papers</a></li>
            <li class="breadcrumb-item active" aria-current="page">My Profile</li>
        </ol>
    </nav>

    <header class="pf-profile-hero mb-4">
        <div class="pf-profile-avatar" aria-hidden="true"><i class="ti ti-user-circle"></i></div>
        <div>
            <h1 class="h3 fw-semibold mb-1">My Profile</h1>
            <p class="mb-0 pf-profile-muted">Manage your account information.</p>
        </div>
    </header>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    @if (TempData["InfoMessage"] is string info)
    {
        <div class="alert alert-info" role="status">@info</div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <section class="card pf-profile-card">
                <div class="card-body p-4">
                    <h2 class="h5 fw-semibold mb-3"><i class="ti ti-user me-2"></i>Personal Information</h2>
                    <form asp-controller="Account" asp-action="Profile" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                            <input asp-for="Email" class="form-control" readonly />
                        </div>
                        <div class="mb-4">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold">Phone Number</label>
                            <input asp-for="PhoneNumber" type="tel" autocomplete="tel" class="form-control" placeholder="+49 ..." />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                        <button class="btn btn-primary" type="submit"><i class="ti ti-device-floppy me-1"></i>Save Changes</button>
                    </form>
                </div>
            </section>
        </div>
        <div class="col-lg-5">
            <section class="card pf-profile-card">
                <div class="card-body p-4">
                    <h2 class="h5 fw-semibold mb-3"><i class="ti ti-lock me-2"></i>Password</h2>
                    <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-outline-primary w-100">
                        <i class="ti ti-key me-1"></i>Change Password
                    </a>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
