@model int
@{
    ViewData["Title"] = "Request Error";
}

@section Styles {
    <link rel="stylesheet" href="~/css/paperflow-errors.css" asp-append-version="true" />
}

<section class="pf-error-section" aria-labelledby="pf-error-heading">
    <div class="pf-error-panel">
        <div class="pf-error-symbol" aria-hidden="true"><i class="ti ti-alert-circle"></i></div>
        <p class="pf-error-eyebrow">REQUEST COULD NOT BE COMPLETED</p>
        <h1 id="pf-error-heading" class="pf-error-number">@Model</h1>
        <h2 class="pf-error-title">This request was not successful</h2>
        <p class="pf-error-description">Please check the address or return to the dashboard.</p>
        <div class="pf-error-actions">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="ti ti-home me-1" aria-hidden="true"></i> Go to Home
            </a>
        </div>
    </div>
</section>
