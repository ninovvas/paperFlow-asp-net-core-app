@{
	ViewData["Title"] = "Research Sources";
}

<div class="pf-public-page">
	<div class="card p-4 mb-4">
		<h2>Research Sources</h2><p class="text-muted">Scientific metadata providers supported by or planned for PaperFlow.</p>
		<div class="row g-3">
			<div class="col-md-4"><section class="card p-3 h-100"><h4>arXiv</h4><p>Open-access research preprints. Currently integrated for searching and import; temporary API rate limits may apply.</p><a href="https://info.arxiv.org/help/api/index.html" target="_blank" rel="noopener noreferrer">API documentation</a></section></div>
			<div class="col-md-4"><section class="card p-3 h-100"><h4>Crossref</h4><p>Planned: DOI and scholarly publication metadata.</p><a href="https://www.crossref.org/documentation/retrieve-metadata/rest-api/" target="_blank" rel="noopener noreferrer">API documentation</a></section></div>
			<div class="col-md-4"><section class="card p-3 h-100"><h4>OpenAlex</h4><p>Planned: works, authors, institutions and citation relationships.</p><a href="https://docs.openalex.org/" target="_blank" rel="noopener noreferrer">API documentation</a></section></div>
		</div>
	</div>

</div>