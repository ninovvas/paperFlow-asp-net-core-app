
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - PaperFlow</title>

    <!-- Modernize Bootstrap CSS -->
    <link rel="stylesheet"
          href="~/modernize/assets/css/styles.min.css"
          asp-append-version="true" />

    <!-- PaperFlow custom CSS: MUST load after Modernize -->
    <link rel="stylesheet"
          href="~/css/paperflow.css"
          asp-append-version="true" />

    <link rel="stylesheet" href="~/css/paperflow-theme.css" asp-append-version="true" />

    <script src="~/js/paperflow-theme.js" asp-append-version="true" defer></script>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="page-wrapper"
         id="main-wrapper"
         data-layout="vertical"
         data-navbarbg="skin6"
         data-sidebartype="full"
         data-sidebar-position="fixed"
         data-header-position="fixed">

        <!-- Sidebar -->
        <aside class="left-sidebar">
            <partial name="_Sidebar" />
        </aside>

        <!-- Main application area -->
        <div class="body-wrapper">

           
            <header class="app-header">
                <nav class="navbar navbar-expand-lg">

                    <!-- Mobile sidebar -->
                    <ul class="navbar-nav">
                        <li class="nav-item d-block d-xl-none">
                            <a class="nav-link sidebartoggler"
                               id="headerCollapse"
                               href="javascript:void(0)"
                               aria-label="Toggle sidebar">
                                <i class="ti ti-menu-2"></i>
                            </a>
                        </li>
                    </ul>

                    <div class="navbar-collapse justify-content-end px-0">

                        <ul class="navbar-nav flex-row ms-auto
                            align-items-center gap-3">

                            <!-- Theme switch -->
                            <li class="nav-item">
                                <button type="button"
                                        class="pf-theme-switch"
                                        data-pf-theme-toggle
                                        aria-label="Toggle color theme"
                                        aria-pressed="false">

                                    <i class="ti ti-moon"
                                       data-pf-theme-icon
                                       aria-hidden="true"></i>

                                    <span data-pf-theme-label
                                          class="d-none d-sm-inline">
                                        Dark mode
                                    </span>
                                </button>
                            </li>

                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <!-- User dropdown -->
                                <li class="nav-item dropdown">

                                    <button type="button"
                                            class="pf-account-trigger dropdown-toggle"
                                            id="paperflowAccountMenu"
                                            data-bs-toggle="dropdown"
                                            data-bs-auto-close="true"
                                            aria-expanded="false"
                                            aria-label="Open account menu">

                                        <span class="pf-account-avatar">
                                            <i class="ti ti-user-circle"></i>
                                        </span>

                                        <span class="pf-account-name
                                            d-none d-sm-inline">
                                            @User.Identity.Name
                                        </span>

                                        <i class="ti ti-chevron-down
                                        pf-account-chevron"
                                           aria-hidden="true"></i>
                                    </button>

                                    <div class="dropdown-menu dropdown-menu-end
                                        pf-account-dropdown"
                                         aria-labelledby="paperflowAccountMenu">

                                        <div class="pf-account-dropdown-header">
                                            <div class="fw-semibold">
                                                My Account
                                            </div>

                                            <div class="small text-muted text-break">
                                                @User.Identity.Name
                                            </div>
                                        </div>

                                        <div class="dropdown-divider"></div>

                                        <a asp-controller="Account"
                                           asp-action="Profile"
                                           class="dropdown-item">

                                            <i class="ti ti-user me-2"></i>
                                            My Profile
                                        </a>

                                        <a asp-controller="Account"
                                           asp-action="ChangePassword"
                                           class="dropdown-item">

                                            <i class="ti ti-key me-2"></i>
                                            Change Password
                                        </a>

                                        <div class="dropdown-divider"></div>

                                        <form asp-area="Identity"
                                              asp-page="/Account/Logout"
                                              asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="dropdown-item
                                                pf-account-logout">

                                                <i class="ti ti-logout me-2"></i>
                                                Logout
                                            </button>
                                        </form>

                                    </div>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a asp-area="Identity"
                                       asp-page="/Account/Login"
                                       class="btn btn-outline-primary">
                                        Login
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a asp-area="Identity"
                                       asp-page="/Account/Register"
                                       class="btn btn-primary">
                                        Register
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </nav>
            </header>



            <!-- Independent scrollable content -->
            <div class="container-fluid paperflow-content">

                <main role="main">
                    @RenderBody()
                </main>

            </div>

        </div>
    </div>

    <!-- JavaScript -->
    <script src="~/modernize/assets/libs/jquery/dist/jquery.min.js"></script>

    <script src="~/modernize/assets/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/modernize/assets/js/sidebarmenu.js"></script>

    <script src="~/modernize/assets/js/app.min.js"></script>

    <script src="~/modernize/assets/libs/simplebar/dist/simplebar.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
