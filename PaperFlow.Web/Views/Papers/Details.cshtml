@model PaperFlow.Services.Models.PaperDetailsDto

@{
    ViewData["Title"] = "Paper Details";
    var published = Model.PublicationDate?.ToString("yyyy-MM-dd") ?? "Not available";
    var deadline = Model.DueDate?.ToString("yyyy-MM-dd") ?? "Not set";
    var progress = Math.Clamp(Model.ReadingProgressPercent ?? 0, 0, 100);
    var status = Model.ReadingStatus ?? "NotStarted";
    var statusTone = status switch
    {
        "Completed" => "is-completed",
        "Reading" => "is-reading",
        "OnHold" => "is-onhold",
        _ => "is-notstarted"
    };
    bool hasPublication = Uri.TryCreate(Model.PublicationUrl, UriKind.Absolute, out var pubUri)
        && (pubUri.Scheme == Uri.UriSchemeHttps || pubUri.Scheme == Uri.UriSchemeHttp);
    bool hasPdf = Uri.TryCreate(Model.PdfUrl, UriKind.Absolute, out var pdfUri)
        && (pdfUri.Scheme == Uri.UriSchemeHttps || pdfUri.Scheme == Uri.UriSchemeHttp);
}

<link rel="stylesheet" href="~/css/paperflow-details-edit.css" asp-append-version="true" />

<div class="pf-detail-page">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Papers" asp-action="Index">My Papers</a></li>
            <li class="breadcrumb-item active" aria-current="page">Paper Details</li>
        </ol>
    </nav>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="ti ti-circle-check me-2"></i>@success
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="ti ti-alert-circle me-2"></i>@error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <header class="pf-detail-hero mb-4">
        <div class="pf-detail-eyebrow"><i class="ti ti-books me-1"></i> RESEARCH LIBRARY · PAPER #@Model.Id</div>
        <h2 class="pf-detail-title">@Model.Title</h2>
        <div class="pf-detail-tags">
            <span class="pf-pill pf-pill-source"><i class="ti ti-database me-1"></i>@(Model.ResearchSourceName ?? "Manual")</span>
            <span class="pf-pill @statusTone">@status</span>
            @foreach (var category in Model.Categories ?? Enumerable.Empty<string>())
            {
                <span class="pf-pill pf-pill-category">@category</span>
            }
        </div>
        <div class="pf-detail-actions mt-4">
            <a asp-controller="Papers" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="ti ti-edit me-1"></i>Edit Paper</a>
            <a asp-controller="PaperReading" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="ti ti-book-2 me-1"></i>Update Reading</a>
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deletePaperModal"><i class="ti ti-trash me-1"></i>Delete</button>
            <a asp-controller="Papers" asp-action="Index" class="btn btn-outline-secondary"><i class="ti ti-arrow-left me-1"></i>Library</a>
        </div>
    </header>

    <div class="row g-4">
        <div class="col-12 col-xl-8">
            <section class="card pf-surface mb-4" aria-labelledby="abstractHeading">
                <div class="card-body p-4">
                    <h5 id="abstractHeading" class="pf-section-title"><span class="pf-section-icon"><i class="ti ti-file-description"></i></span> Abstract</h5>
                    @if (!string.IsNullOrWhiteSpace(Model.Abstract))
                    {
                        <p class="pf-long-text mb-0">@Model.Abstract</p>
                    }
                    else
                    {
                        <p class="pf-empty mb-0">No abstract available.</p>
                    }
                </div>
            </section>


            <section class="card pf-surface mb-4"
                     aria-labelledby="authorsHeading">

                <div class="card-body p-4">

                    <h5 id="authorsHeading" class="pf-section-title">
                        <span class="pf-section-icon">
                            <i class="ti ti-users"></i>
                        </span>

                        Authors

                        @if (Model.Authors?.Any() == true)
                        {
                            <span class="text-muted small ms-2">
                                (@Model.Authors.Count)
                            </span>
                        }
                    </h5>

                    @if (Model.Authors?.Any() == true)
                    {
                        <div class="pf-author-chips">

                            @foreach (var author in Model.Authors)
                            {
                                <span class="pf-author-chip">

                                    <span>@author.FullName</span>

                                    @if (!string.IsNullOrWhiteSpace(author.Orcid))
                                    {
                                        <a href="@($"https://orcid.org/{Uri.EscapeDataString(author.Orcid)}")"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           class="pf-author-orcid"
                                           title="View ORCID profile"
                                           aria-label="ORCID profile for @author.FullName">

                                            <i class="ti ti-external-link"></i>
                                        </a>
                                    }

                                </span>
                            }

                        </div>
                    }
                    else
                    {
                        <p class="pf-empty mb-0">
                            No authors recorded.
                        </p>
                    }

                </div>
            </section>


            <section class="card pf-surface mb-4" aria-labelledby="notesHeading">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-3">
                        <h5 id="notesHeading" class="pf-section-title mb-0"><span class="pf-section-icon"><i class="ti ti-notes"></i></span> Personal Notes</h5>
                        <a asp-controller="PaperReading" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm"><i class="ti ti-pencil me-1"></i>Edit Notes</a>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.Notes))
                    {
                        <p class="pf-long-text mb-0">@Model.Notes</p>
                    }
                    else
                    {
                        <p class="pf-empty mb-0">No personal notes yet.</p>
                    }
                </div>
            </section>
        </div>

        <aside class="col-12 col-xl-4">
            <section class="card pf-surface mb-4" aria-labelledby="readingHeading">
                <div class="card-body p-4">
                    <h5 id="readingHeading" class="pf-section-title"><span class="pf-section-icon"><i class="ti ti-book-2"></i></span> Reading Progress</h5>
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted">Completion</span>
                        <strong class="pf-progress-value">@(Model.ReadingProgressPercent.HasValue ? $"{progress}%" : "N/A")</strong>
                    </div>
                    <div class="progress pf-progress-track" role="progressbar" aria-label="Reading progress" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar pf-progress-fill" style="width: @(progress)%"></div>
                    </div>
                    <div class="small text-muted mt-2 mb-4">Page @Model.CurrentPage of @(Model.TotalPages?.ToString() ?? "unknown")</div>
                    <dl class="pf-metadata-list">
                        <div><dt>Status</dt><dd><span class="pf-pill @statusTone">@status</span></dd></div>
                        <div><dt>Rating</dt><dd>@(Model.Rating.HasValue ? $"{Model.Rating}/5" : "Not rated")</dd></div>
                        <div><dt>Deadline</dt><dd>@deadline</dd></div>
                        <div><dt>Started</dt><dd>@(Model.StartedReadingOn?.ToString("yyyy-MM-dd") ?? "Not started")</dd></div>
                        <div><dt>Completed</dt><dd>@(Model.CompletedOn?.ToString("yyyy-MM-dd") ?? "Not completed")</dd></div>
                    </dl>
                    <a asp-controller="PaperReading" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary w-100"><i class="ti ti-pencil me-1"></i>Update Progress</a>
                </div>
            </section>

            <section class="card pf-surface mb-4" aria-labelledby="publicationHeading">
                <div class="card-body p-4">
                    <h5 id="publicationHeading" class="pf-section-title"><span class="pf-section-icon"><i class="ti ti-file-certificate"></i></span> Publication</h5>
                    <dl class="pf-metadata-list">
                        <div><dt>Published</dt><dd>@published</dd></div>
                        <div><dt>Source</dt><dd>@(Model.ResearchSourceName ?? "Manual")</dd></div>
                        <div><dt>External ID</dt><dd class="text-break">@(Model.ExternalId ?? "N/A")</dd></div>
                        <div><dt>DOI</dt><dd class="text-break">@(Model.Doi ?? "N/A")</dd></div>
                        <div><dt>Added</dt><dd>@Model.CreatedOn.ToString("yyyy-MM-dd")</dd></div>
                        <div><dt>Updated</dt><dd>@(Model.ModifiedOn?.ToString("yyyy-MM-dd") ?? "Never")</dd></div>
                    </dl>
                    <div class="d-grid gap-2 mt-3">
                        @if (hasPublication)
                        {
                            <a class="btn btn-outline-primary" href="@Model.PublicationUrl" target="_blank" rel="noopener noreferrer"><i class="ti ti-external-link me-1"></i>Publication</a>
                        }
                        @if (hasPdf)
                        {
                            <a class="btn btn-primary" href="@Model.PdfUrl" target="_blank" rel="noopener noreferrer"><i class="ti ti-file-type-pdf me-1"></i>Open PDF</a>
                        }
                        @if (!hasPublication && !hasPdf)
                        {
                            <p class="pf-empty mb-0">No external links available.</p>
                        }
                    </div>
                </div>
            </section>
        </aside>
    </div>
</div>

<div class="modal fade" id="deletePaperModal" tabindex="-1" aria-labelledby="deletePaperModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deletePaperModalLabel"><i class="ti ti-alert-triangle text-danger me-2"></i>Delete Paper</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this paper?</p>
                <div class="rounded border p-3 fw-semibold text-break">@Model.Title</div>
                <p class="text-danger small mt-3 mb-0">This action cannot be undone. Reading progress, ratings and notes will be removed.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <form asp-controller="Papers" asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger"><i class="ti ti-trash me-1"></i>Yes, Delete Paper</button>
                </form>
            </div>
        </div>
    </div>
</div>
