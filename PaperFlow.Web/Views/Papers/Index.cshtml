@using PaperFlow.Data.Models
@model IEnumerable<Paper>

@{
    ViewData["Title"] = "My Papers";

    var papers = Model?.ToList() ?? new List<Paper>();

    int totalCount = papers.Count;

    int readingCount = papers.Count(p =>
        p.Status.ToString() == "Reading");

    int completedCount = papers.Count(p =>
        p.Status.ToString() == "Completed");
}

<div class="mb-4">
    <div class="d-flex justify-content-between
        align-items-center flex-wrap gap-3">

        <div>
            <h3 class="fw-semibold mb-1">My Papers</h3>
            <p class="text-muted mb-0">
                Manage your research paper library.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Papers"
               asp-action="Create"
               class="btn btn-primary">
                <i class="ti ti-plus me-1"></i>
                Add Paper
            </a>

            @if (totalCount > 0)
            {
                <a asp-controller="Papers"
                   asp-action="DeleteAll"
                   class="btn btn-outline-danger">
                    <i class="ti ti-trash me-1"></i>
                    Delete All
                </a>
            }
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success" role="alert">
        @success
    </div>
}

@if (TempData["InfoMessage"] is string info)
{
    <div class="alert alert-info" role="alert">
        @info
    </div>
}

@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger" role="alert">
        @error
    </div>
}

<!-- Library overview -->

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card mb-0 h-100">
            <div class="card-body">
                <div class="text-muted mb-2">Total Papers</div>
                <h3 class="fw-semibold mb-0">@totalCount</h3>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card mb-0 h-100">
            <div class="card-body">
                <div class="text-muted mb-2">
                    Currently Reading
                </div>
                <h3 class="fw-semibold mb-0">@readingCount</h3>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card mb-0 h-100">
            <div class="card-body">
                <div class="text-muted mb-2">Completed</div>
                <h3 class="fw-semibold mb-0">@completedCount</h3>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between
            align-items-center mb-4">

            <h5 class="fw-semibold mb-0">
                Research Library
            </h5>

            <span class="text-muted small">
                @totalCount paper(s)
            </span>
        </div>

        @if (papers.Count == 0)
        {
            <div class="text-center py-5">
                <i class="ti ti-books fs-8 text-muted"></i>

                <h5 class="mt-3">No papers saved yet</h5>

                <p class="text-muted">
                    Search scientific publications or
                    add your first paper manually.
                </p>

                <a asp-controller="PaperSearch"
                   asp-action="Index"
                   class="btn btn-primary">
                    Search Papers
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover
                    align-middle paperflow-papers-table">

                    <thead>
                        <tr>
                            <th>Paper</th>
                            <th>Published</th>
                            <th>Status</th>
                            <th>Rating</th>
                            <th>PDF</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var paper in papers)
                        {
                            <tr>
                                <td class="paperflow-title-column">
                                    <a asp-controller="PaperDetails"
                                       asp-action="Details"
                                       asp-route-id="@paper.Id"
                                       class="fw-semibold text-decoration-none">
                                        @paper.Title
                                    </a>
                                </td>

                                <td class="paperflow-date">
                                    @(paper.PublicationDate?
                                        .ToString("yyyy-MM-dd") ?? "N/A")
                                </td>

                                <td>
                                    @{
                                        string statusText =
                                            paper.Status.ToString();

                                        string statusClass = statusText switch
                                        {
                                            "Completed" => "bg-success-subtle text-success",
                                            "Reading" => "bg-primary-subtle text-primary",
                                            "OnHold" => "bg-warning-subtle text-warning",
                                            _ => "bg-light text-dark border"
                                        };
                                    }

                                    <span class="badge @statusClass">
                                        @statusText
                                    </span>
                                </td>

                                <td class="paperflow-nowrap">
                                    @if (paper.Rating.HasValue)
                                    {
                                        <span class="text-warning">
                                            <i class="ti ti-star-filled"></i>
                                        </span>
                                        @paper.Rating
                                        <span class="text-muted">/5</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">
                                            Not rated
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(paper.PdfUrl)
                                        && Uri.TryCreate(
                                            paper.PdfUrl,
                                            UriKind.Absolute,
                                            out var pdfUri)
                                        && (pdfUri.Scheme == Uri.UriSchemeHttps
                                            || pdfUri.Scheme == Uri.UriSchemeHttp))
                                    {
                                        <a href="@paper.PdfUrl"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           class="paperflow-nowrap">
                                            <i class="ti ti-file-type-pdf me-1"></i>
                                            PDF
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex justify-content-end
                                        align-items-center gap-1
                                        paperflow-actions">

                                        <a asp-controller="PaperDetails"
                                           asp-action="Details"
                                           asp-route-id="@paper.Id"
                                           class="btn btn-outline-primary btn-sm"
                                           title="View Details"
                                           aria-label="View Details">
                                            <i class="ti ti-eye"></i>
                                        </a>

                                        <a asp-controller="Papers"
                                           asp-action="Edit"
                                           asp-route-id="@paper.Id"
                                           class="btn btn-outline-secondary btn-sm"
                                           title="Edit Paper"
                                           aria-label="Edit Paper">
                                            <i class="ti ti-edit"></i>
                                        </a>

                                        <button type="button"
                                                class="btn btn-outline-danger btn-sm"
                                                title="Delete Paper"
                                                aria-label="Delete Paper"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deletePaperModal"
                                                data-paper-id="@paper.Id"
                                                data-paper-title="@paper.Title">
                                            <i class="ti ti-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- One confirmation modal for the entire table -->

<div class="modal fade"
     id="deletePaperModal"
     tabindex="-1"
     aria-labelledby="deletePaperModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title"
                    id="deletePaperModalLabel">
                    Delete Paper
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <p class="fw-semibold">
                    Are you sure you want to delete this paper?
                </p>

                <p id="deletePaperTitle"
                   class="text-muted text-break"></p>

                <p class="text-danger small mb-0">
                    This action cannot be undone.
                    Reading progress, rating and notes
                    will be permanently removed.
                </p>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <form id="deletePaperForm"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-danger">
                        Yes, Delete Paper
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const modal =
                document.getElementById("deletePaperModal");

            if (!modal) return;

            modal.addEventListener("show.bs.modal", function(event) {
                const button = event.relatedTarget;

                const id = button.dataset.paperId;
                const title = button.dataset.paperTitle;

                document.getElementById("deletePaperTitle")
                    .textContent = title;

                document.getElementById("deletePaperForm")
                    .action =
                    "@Url.Content("~/Papers/Delete/")" +
                    encodeURIComponent(id);
            });
        });
    </script>
}
