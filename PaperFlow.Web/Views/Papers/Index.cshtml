@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Html
@using PaperFlow.Common.Enums
@model PaperFlow.Web.ViewModels.Papers.PaperLibraryViewModel
<link rel="stylesheet" href="~/css/paperflow-library.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/paperflow-library-search.css" asp-append-version="true" />
@{
    ViewData["Title"] = "My Papers";
    var q = Model.Query;
    var statuses = Enum.GetNames<ReadingStatus>();
    int first = Model.FilteredCount == 0 ? 0 : (q.Page - 1) * q.PageSize + 1;
    int last = Math.Min(q.Page * q.PageSize, Model.FilteredCount);
    IHtmlContent Highlight(string? value)
    {
        var text = value ?? string.Empty;
        var term = q.Search;
        if (string.IsNullOrWhiteSpace(term)) return new HtmlString(HtmlEncoder.Default.Encode(text));
        int at = 0;
        var result = new System.Text.StringBuilder();
        while (at < text.Length)
        {
            int found = text.IndexOf(term, at, StringComparison.OrdinalIgnoreCase);
            if (found < 0) { result.Append(HtmlEncoder.Default.Encode(text[at..])); break; }
            result.Append(HtmlEncoder.Default.Encode(text[at..found]));
            result.Append("<mark class=\"pf-search-match\">");
            result.Append(HtmlEncoder.Default.Encode(text.Substring(found, term.Length)));
            result.Append("</mark>");
            at = found + term.Length;
        }
        return new HtmlString(result.ToString());
    }
    string? AbstractSnippet(string? abstractText)
    {
        if (string.IsNullOrWhiteSpace(abstractText) || string.IsNullOrWhiteSpace(q.Search)) return null;
        int hit = abstractText.IndexOf(q.Search, StringComparison.OrdinalIgnoreCase);
        if (hit < 0) return null;
        int start = Math.Max(0, hit - 45);
        int length = Math.Min(abstractText.Length - start, 190);
        return (start > 0 ? "…" : "") + abstractText.Substring(start, length) +
            (start + length < abstractText.Length ? "…" : "");
    }

}

<div class="pf-library-header d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div><div class="pf-library-eyebrow"><i class="ti ti-books me-1"></i> RESEARCH WORKSPACE</div><h3 class="fw-semibold mb-1">My Papers</h3><p class="text-muted mb-0">Discover, organize and track your research.</p></div>
    <div class="d-flex gap-2">
        <a asp-controller="Papers" asp-action="Create" class="btn btn-primary"><i class="ti ti-plus me-1"></i>Add Paper</a>
        @if (Model.TotalPapers > 0)
        {
            <a asp-controller="Papers" asp-action="DeleteAll" class="btn btn-outline-danger"><i class="ti ti-trash me-1"></i>Delete All</a>
        }
    </div>
</div>

@foreach (string key in new[] { "SuccessMessage", "InfoMessage", "ErrorMessage" })
{
    if (TempData[key] is string msg)
    {
        <div class="alert @(key == "ErrorMessage" ? "alert-danger" : key == "InfoMessage" ? "alert-info" : "alert-success")" role="alert">@msg</div>
    }
}

<div class="row g-3 mb-4 pf-library-stats">
    <div class="col-md-4"><div class="card mb-0 pf-stat-card pf-stat-total"><div class="card-body d-flex align-items-center justify-content-between"><div><div class="pf-stat-label">Total Papers</div><h3 class="pf-stat-value mb-0">@Model.TotalPapers</h3></div><div class="pf-stat-icon"><i class="ti ti-books"></i></div></div></div></div>
    <div class="col-md-4"><div class="card mb-0 pf-stat-card pf-stat-reading"><div class="card-body d-flex align-items-center justify-content-between"><div><div class="pf-stat-label">Currently Reading</div><h3 class="pf-stat-value mb-0">@Model.ReadingCount</h3></div><div class="pf-stat-icon"><i class="ti ti-book-2"></i></div></div></div></div>
    <div class="col-md-4"><div class="card mb-0 pf-stat-card pf-stat-completed"><div class="card-body d-flex align-items-center justify-content-between"><div><div class="pf-stat-label">Completed</div><h3 class="pf-stat-value mb-0">@Model.CompletedCount</h3></div><div class="pf-stat-icon"><i class="ti ti-circle-check"></i></div></div></div></div>
</div>

<div class="card pf-library-card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3"><div><h5 class="fw-semibold mb-1">Research Library</h5><div class="text-muted small">Your saved publications, in one place</div></div><span class="pf-results-count">@Model.FilteredCount matching / @Model.TotalPapers total</span></div>

        <form asp-controller="Papers" asp-action="Index" method="get" id="libraryFilters" class="row g-3 align-items-end mb-4 pf-library-filters">
            <div class="col-lg-4 col-md-6"><label for="librarySearch" class="form-label">Search by title, DOI, author, category or abstract</label><input id="librarySearch" name="Search" value="@q.Search" maxlength="200" class="form-control" placeholder="Search my library..." /></div>
            <div class="col-lg-2 col-md-3">
                <label for="libraryStatus" class="form-label">Reading status</label><select id="libraryStatus" name="Status" class="form-select">
                <option value="">All statuses</option>
                @foreach (string status in statuses)
                {
                    if (string.Equals(q.Status, status, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@status" selected>@status</option>
                    }
                    else
                    {
                        <option value="@status">@status</option>
                    }
                }
            </select>
        </div>
        <div class="col-lg-2 col-md-3">
            <label for="librarySource" class="form-label">Source</label><select id="librarySource" name="SourceId" class="form-select">
            <option value="">All sources</option>
            @foreach (var source in Model.Sources)
            {
                if (q.SourceId == source.Id)
                {
                    <option value="@source.Id" selected>@source.Name</option>
                }
                else
                {
                    <option value="@source.Id">@source.Name</option>
                }
            }
        </select>
    </div>
    <div class="col-lg-2 col-md-3">
        <label for="librarySort" class="form-label">Sort by</label><select id="librarySort" name="Sort" class="form-select">
        @foreach (var sortItem in new[] { ("relevance", "Best match"), ("added_desc", "Recently added"), ("added_asc", "Oldest added"), ("title_asc", "Title A–Z"), ("title_desc", "Title Z–A"), ("published_desc", "Newest publication"), ("published_asc", "Oldest publication"), ("status_asc", "Status A–Z"), ("status_desc", "Status Z–A"), ("rating_desc", "Highest rating"), ("rating_asc", "Lowest rating") })
        {
            if (q.Sort == sortItem.Item1)
            {
                <option value="@sortItem.Item1" selected>@sortItem.Item2</option>
            }
            else
            {
                <option value="@sortItem.Item1">@sortItem.Item2</option>
            }
        }
    </select>
</div>
<div class="col-lg-2 col-md-3"><div class="d-flex gap-2"><button type="submit" class="btn btn-primary"><i class="ti ti-filter me-1"></i>Apply</button><a asp-action="Index" asp-controller="Papers" class="btn btn-outline-secondary">Reset</a></div></div>
</form>

    @if (Model.Papers.Count == 0)
{
    <div class="text-center py-5">
        <i class="ti ti-books fs-8 text-muted"></i><h5 class="mt-3">@(Model.TotalPapers == 0 ? "No papers saved yet" : "No papers match your filters")</h5>
        <p class="text-muted">@(Model.TotalPapers == 0 ? "Add or import your first research paper." : "Try changing the search or filters.")</p>
        @if (Model.TotalPapers == 0)
        {
            <a asp-controller="PaperSearch" asp-action="Index" class="btn btn-primary">Search Papers</a>
        }
        else
        {

            <a asp-controller="Papers" asp-action="Index" class="btn btn-outline-primary">Clear filters</a>
        }
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle paperflow-papers-table pf-library-table">
            <thead>
                <tr>
                    <th><a asp-action="Index" asp-route-Search="@q.Search" asp-route-Status="@q.Status" asp-route-SourceId="@q.SourceId" asp-route-Sort="@(q.Sort == "title_asc" ? "title_desc" : "title_asc")">Paper <i class="ti ti-arrows-sort"></i></a></th>
                    <th class="paperflow-date"><a asp-action="Index" asp-route-Search="@q.Search" asp-route-Status="@q.Status" asp-route-SourceId="@q.SourceId" asp-route-Sort="@(q.Sort == "published_desc" ? "published_asc" : "published_desc")">Published <i class="ti ti-arrows-sort"></i></a></th>
                    <th><a asp-action="Index" asp-route-Search="@q.Search" asp-route-Status="@q.Status" asp-route-SourceId="@q.SourceId" asp-route-Sort="@(q.Sort == "status_asc" ? "status_desc" : "status_asc")">Status <i class="ti ti-arrows-sort"></i></a></th>
                    <th><a asp-action="Index" asp-route-Search="@q.Search" asp-route-Status="@q.Status" asp-route-SourceId="@q.SourceId" asp-route-Sort="@(q.Sort == "rating_desc" ? "rating_asc" : "rating_desc")">Rating <i class="ti ti-arrows-sort"></i></a></th>
                    <th>PDF</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var paper in Model.Papers)
                {
                    <tr>
                        <td class="paperflow-title-column">
                            <a asp-controller="PaperDetails" asp-action="Details" asp-route-id="@paper.Id" class="fw-semibold text-decoration-none paperflow-title-clamp">@Highlight(paper.Title)</a>
                            @if (AbstractSnippet(paper.Abstract) is string snippet)
                            {
                                <div class="pf-search-snippet mt-1">@Highlight(snippet)</div>
                            }
                        </td>
                        <td class="paperflow-date">@(paper.PublicationDate?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                        <td>
                            @{
                                string text = paper.Status.ToString(); string badgeClass = text switch { "Completed" => "bg-success-subtle text-success", "Reading" => "bg-primary-subtle text-primary", "OnHold" => "bg-warning-subtle text-warning", _ => "bg-light text-dark border" };
                            }
                            <span class="badge @badgeClass pf-status-badge">@text</span>
                        </td>
                        <td class="paperflow-nowrap">
                            @if (paper.Rating.HasValue)
                            {
                                <span class="text-warning"><i class="ti ti-star-filled"></i></span>
                                @paper.Rating
                                <span class="text-muted">/5</span>
                            }
                            else
                            {

                                <span class="small text-muted">Not rated</span>
                            }
                        </td>
                        <td>
                            @if (Uri.TryCreate(paper.PdfUrl, UriKind.Absolute, out var pdf) && (pdf.Scheme == "https" || pdf.Scheme == "http"))
                            {
                                <a href="@paper.PdfUrl" target="_blank" rel="noopener noreferrer">PDF</a>
                            }
                            else
                            {

                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex justify-content-end gap-1 paperflow-actions">
                                <a asp-controller="PaperDetails" asp-action="Details" asp-route-id="@paper.Id" class="btn btn-outline-primary btn-sm" title="Details" aria-label="Details"><i class="ti ti-eye"></i></a>
                                <a asp-controller="Papers" asp-action="Edit" asp-route-id="@paper.Id" class="btn btn-outline-secondary btn-sm" title="Edit" aria-label="Edit"><i class="ti ti-edit"></i></a>
                                <button type="button" class="btn btn-outline-danger btn-sm" title="Delete" aria-label="Delete" data-bs-toggle="modal" data-bs-target="#deletePaperModal" data-paper-id="@paper.Id" data-paper-title="@paper.Title"><i class="ti ti-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-4 pf-library-pagination">
        <div class="text-muted small">Showing @first–@last of @Model.FilteredCount papers</div>
        <nav aria-label="Library pages">
            <ul class="pagination mb-0">
                <li class="page-item @(q.Page <= 1 ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-Search="@q.Search" asp-route-Status="@q.Status" asp-route-SourceId="@q.SourceId" asp-route-Sort="@q.Sort" asp-route-Page="@(q.Page - 1)">Previous</a></li>
                @for (int p = Math.Max(1, q.Page - 2); p <= Math.Min(Model.TotalPages, q.Page + 2); p++)
                {
                    int pageNumber = p;
                    <li class="page-item @(q.Page == pageNumber ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-Search="@q.Search" asp-route-Status="@q.Status" asp-route-SourceId="@q.SourceId" asp-route-Sort="@q.Sort" asp-route-Page="@pageNumber">@pageNumber</a></li>
                }
                <li class="page-item @(q.Page >= Model.TotalPages ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-Search="@q.Search" asp-route-Status="@q.Status" asp-route-SourceId="@q.SourceId" asp-route-Sort="@q.Sort" asp-route-Page="@(q.Page + 1)">Next</a></li>
            </ul>
        </nav>
    </div>
}
</div>
</div>

<div class="modal fade" id="deletePaperModal" tabindex="-1" aria-labelledby="deletePaperModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title" id="deletePaperModalLabel">Delete Paper</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body"><p class="fw-semibold">Are you sure you want to delete this paper?</p><p id="deletePaperTitle" class="text-muted text-break"></p><p class="text-danger small mb-0">This cannot be undone. Reading progress, rating and notes will be removed.</p></div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><form id="deletePaperForm" method="post">@Html.AntiForgeryToken()<button type="submit" class="btn btn-danger">Yes, Delete Paper</button></form></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const modal = document.getElementById("deletePaperModal");
            if (modal) {
                modal.addEventListener("show.bs.modal", function (event) {
                    const button = event.relatedTarget;
                    document.getElementById("deletePaperTitle").textContent = button.dataset.paperTitle;
                    document.getElementById("deletePaperForm").action = "@Url.Content("~/Papers/Delete/")" + encodeURIComponent(button.dataset.paperId);
                });
            }
            window.addEventListener("pageshow", function () {
                const btn = document.querySelector('#libraryFilters button[type="submit"]');
                if (btn) { btn.disabled = false; btn.innerHTML = '<i class="ti ti-filter me-1"></i>Apply'; }
            });
            const filterForm = document.getElementById("libraryFilters");
            if (filterForm) {
                filterForm.addEventListener("submit", function () {
                    const submit = filterForm.querySelector('button[type="submit"]');
                    if (submit) { submit.disabled = true; submit.innerHTML = '<span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>Loading'; }
                });
            }
        });
    </script>
}
