@model IEnumerable<PaperFlow.Data.Models.Paper>

@{
    ViewData["Title"] = "My Papers";
}

<div class="card">
    <div class="card-body">

        <div class="d-flex justify-content-between
            align-items-center mb-4">

            <h4 class="card-title fw-semibold mb-0">
                My Papers
            </h4>

            <a asp-controller="Papers"
               asp-action="Create"
               class="btn btn-primary">
                <i class="ti ti-plus me-1"></i>
                Add Paper
            </a>
        </div>

        @if (TempData["SuccessMessage"] is string success)
        {
            <div class="alert alert-success">
                @success
            </div>
        }

        @if (TempData["InfoMessage"] is string info)
        {
            <div class="alert alert-info">
                @info
            </div>
        }

        @if (TempData["ErrorMessage"] is string error)
        {
            <div class="alert alert-danger">
                @error
            </div>
        }

        @if (!Model.Any())
        {
            <div class="alert alert-info">
                Your library is empty. Search or add a paper.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Published</th>
                            <th>Status</th>
                            <th>Rating</th>
                            <th>PDF</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var paper in Model)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="PaperDetails"
                                       asp-action="Details"
                                       asp-route-id="@paper.Id"
                                       class="fw-semibold text-decoration-none">
                                        @paper.Title
                                    </a>
                                </td>

                                <td>
                                    @(paper.PublicationDate?.ToString("yyyy-MM-dd")
                                        ?? "N/A")
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @paper.Status
                                    </span>
                                </td>

                                <td>
                                    @(paper.Rating?.ToString() ?? "Not rated")
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(paper.PdfUrl)
                                         && Uri.TryCreate(paper.PdfUrl,
                                             UriKind.Absolute, out var pdfUri)
                                         && (pdfUri.Scheme == Uri.UriSchemeHttps
                                             || pdfUri.Scheme == Uri.UriSchemeHttp))
                                    {
                                        <a href="@paper.PdfUrl"
                                           target="_blank"
                                           rel="noopener noreferrer">
                                            Open PDF
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>

                                <td>
                                    <a asp-controller="PaperDetails"
                                       asp-action="Details"
                                       asp-route-id="@paper.Id"
                                       class="btn btn-outline-primary btn-sm">
                                        <i class="ti ti-eye me-1"></i>
                                        Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }

    </div>
</div>
