@model PaperFlow.Web.ViewModels.Papers.PaperSearchViewModel

<div class="card border mb-4">
    <div class="card-body">

        <h6 class="fw-semibold mb-3">
            Search Sources
        </h6>

        <div class="row g-3">
            @foreach (string source in Model.AvailableSources)
            {
                <div class="col-md-4">
                    <div class="form-check">

                        <input class="form-check-input"
                               type="checkbox"
                               name="SelectedSources"
                               value="@source"
                               id="source_@source"
                               checked="@Model.SelectedSources.Contains(source)" />

                        <label class="form-check-label"
                               for="source_@source">
                            @source
                        </label>

                    </div>
                </div>
            }
        </div>

        <div class="mt-3">
            <button type="button"
                    id="selectAllSources"
                    class="btn btn-outline-primary btn-sm">
                Select All Sources
            </button>

            <button type="button"
                    id="clearSources"
                    class="btn btn-outline-secondary btn-sm">
                Clear Selection
            </button>
        </div>

    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const checkboxes = document.querySelectorAll(
            'input[name="SelectedSources"]');

        document.getElementById("selectAllSources")
            .addEventListener("click", function() {
                checkboxes.forEach(cb => cb.checked = true);
            });

        document.getElementById("clearSources")
            .addEventListener("click", function() {
                checkboxes.forEach(cb => cb.checked = false);
            });
    });
</script>

