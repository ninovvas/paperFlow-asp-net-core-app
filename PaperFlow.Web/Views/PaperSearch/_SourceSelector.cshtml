@model PaperFlow.Web.ViewModels.Papers.PaperSearchViewModel

<div class="card border mb-4">
    <div class="card-body">
        <h6 class="fw-semibold mb-3">Research Sources</h6>
        <div class="row g-3">
            @foreach (string source in Model.AvailableSources)
            {
                string displayName = source.Equals("arxiv", StringComparison.OrdinalIgnoreCase)
                    ? "arXiv"
                    : source.Equals("crossref", StringComparison.OrdinalIgnoreCase)
                        ? "Crossref"
                        : source.Equals("openalex", StringComparison.OrdinalIgnoreCase)
                            ? "OpenAlex"
                            : source;

                <div class="col-md-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox"
                               name="SelectedSources" value="@source"
                               id="source_@source"
                               checked="@Model.SelectedSources.Contains(source, StringComparer.OrdinalIgnoreCase)" />
                        <label class="form-check-label" for="source_@source">@displayName</label>
                    </div>
                </div>
            }
        </div>
        <div class="d-flex gap-2 mt-3">
            <button type="button" id="selectAllSources" class="btn btn-outline-primary btn-sm">Select All Sources</button>
            <button type="button" id="clearSources" class="btn btn-outline-secondary btn-sm">Clear Selection</button>
        </div>
        <div class="small text-muted mt-3">
            Crossref search uses publication dates, while arXiv uses submission dates.
            arXiv category codes (such as cs.RO) do not apply to Crossref.
            OpenAlex and Crossref use publication dates. arXiv categories are not shared across providers.
            OpenAlex can supply abstracts that are missing from Crossref, when available.
        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const checkboxes = document.querySelectorAll('input[name="SelectedSources"]');
        document.getElementById("selectAllSources")?.addEventListener("click", function() {
            checkboxes.forEach(cb => cb.checked = true);
        });
        document.getElementById("clearSources")?.addEventListener("click", function() {
            checkboxes.forEach(cb => cb.checked = false);
        });
    });
</script>
